{
  "name": "ai-sdk-skills-chat",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": ">=24", "npm": ">=11" },
  "workspaces": ["apps/*"],
  "scripts": {
    "dev": "concurrently --kill-others --names api,web \"npm run dev -w @chat/server\" \"npm run dev -w @chat/web\"",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "@ai-sdk/tool-bash": { "zod": "4.6.7" },
    "just-bash": { "minimatch": "11.0.1" }
  }
}
